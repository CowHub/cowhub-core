FROM amazonlinux:with-sources

MAINTAINER freddie.a.lindsey@gmail.com

RUN pwd

WORKDIR /home/ec2/cowhub-core

# Install python
RUN yum -y update && \
    yum -y install python2.7-dev wget unzip libatlas-base-dev gfortran libv4l-dev
RUN wget https://bootstrap.pypa.io/get-pip.py && python get-pip.py

# Install opencv dependencies
RUN yum -y groupinstall "Development Tools"
RUN yum -y install cmake git libgtk2.0-dev pkg-config libavcodec-dev libavformat-dev libswscale-dev
RUN yum -y install python-dev python-numpy libtbb2 libtbb-dev libjpeg-dev libpng-dev libtiff-dev \
                              libjasper-dev libdc1394-22-dev

# Install opencv
RUN wget https://github.com/Itseez/opencv/archive/3.1.0.zip -O opencv3.zip && \
    unzip -q opencv3.zip && \
    mv /home/ec2/cowhub-core/opencv-3.1.0 /home/ec2/cowhub-core/opencv
RUN mkdir -p /home/ec2/cowhub-core/opencv/build

RUN wget https://github.com/Itseez/opencv_contrib/archive/3.1.0.zip -O /home/ec2/cowhub-core/opencv_contrib3.zip && \
    unzip -q /home/ec2/cowhub-core/opencv_contrib3.zip && \
    mv /home/ec2/cowhub-core/opencv_contrib-3.1.0 /home/ec2/cowhub-core/opencv_contrib

WORKDIR /home/ec2/cowhub-core/opencv/build
RUN cmake -D CMAKE_BUILD_TYPE=RELEASE \
	-D BUILD_PYTHON_SUPPORT=ON \
	-D CMAKE_INSTALL_PREFIX=/home/ec2/cowhub-core/bin \
	-D OPENCV_EXTRA_MODULES_PATH=/opencv_contrib/modules \
	-D BUILD_NEW_PYTHON_SUPPORT=ON \
	-D WITH_IPP=OFF \
	-D WITH_V4L=ON ..
RUN make -j$NUM_CORES
RUN make install
RUN ldconfig

# Install packages
WORKDIR /home/ec2/cowhub-core
COPY requirements.txt ./
RUN pip install -r requirements.txt

# Project
COPY . .
